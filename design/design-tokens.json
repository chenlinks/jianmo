    "ui": {"label": "界面正文 / 导航", "size": 13, "lineHeight": 20, "weight": 400, "sample": "全部文档"},
    "button": {"label": "按钮文字", "size": 13, "lineHeight": 20, "weight": 500, "sample": "编辑文档"},
    "tool-symbol": {"label": "格式工具符号", "size": 16, "lineHeight": 20, "weight": 500, "sample": "H₂  B  I"},
    "label": {"label": "分组 / 表单标签", "size": 12, "lineHeight": 18, "weight": 500, "sample": "我的文档"},
    "caption": {"label": "摘要 / 辅助说明 / 状态", "size": 12, "lineHeight": 18, "weight": 400, "sample": "已保存到浏览器"},
    "article-title": {"label": "文稿一级标题", "size": 32, "lineHeight": 44, "weight": 600, "sample": "让想法，自然成文"},
    "mobile-article-title": {"label": "手机文稿一级标题", "size": 28, "lineHeight": 40, "weight": 600, "sample": "让想法，自然成文"},
    "article-h2": {"label": "文稿二级标题", "size": 20, "lineHeight": 30, "weight": 600, "sample": "简单书写，自有章法"},
    "article-h3": {"label": "文稿三级标题", "size": 17, "lineHeight": 28, "weight": 600, "sample": "记录今天的想法"},
    "article": {"label": "文稿正文", "size": 17, "lineHeight": 30, "weight": 400, "sample": "文字的力量，来自清晰而真诚的表达。"},
    "quote": {"label": "文稿引用", "size": 16, "lineHeight": 28, "weight": 400, "sample": "把值得留住的话，写在这里。"},
    "table": {"label": "表格正文", "size": 14, "lineHeight": 22, "weight": 400, "sample": "内容与结构，同样清楚。"},
    "source": {"label": "源码编辑", "size": 13, "lineHeight": 26, "weight": 400, "sample": "## Simple, focused writing", "family": "mono"},
    "mobile-source": {"label": "手机源码编辑", "size": 16, "lineHeight": 28, "weight": 400, "sample": "## Focused writing", "family": "mono"},
    "mobile-input": {"label": "手机表单输入", "size": 16, "lineHeight": 24, "weight": 400, "sample": "周末阅读笔记"},
    "code": {"label": "代码块", "size": 13, "lineHeight": 22, "weight": 400, "sample": "const idea = 'Start writing';", "family": "mono"}
  },
  "spacing": {"1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64},
  "radii": {"small": 4, "control": 6, "panel": 8, "dialog": 12, "phone": 28},
  "components": {
    "button": {"height": 32, "mobileHeight": 44, "paddingX": 12, "gap": 6, "iconSize": 16},
    "icon-button": {"height": 28, "mobileHeight": 44, "iconSize": 16},
    "format-button": {"height": 28, "mobileHeight": 44, "iconSize": 16},
    "input": {"height": 40, "mobileHeight": 44, "paddingX": 12},
    "search": {"height": 36, "mobileHeight": 44},
    "navigation": {"height": 36, "mobileHeight": 44},
    "document-row": {"height": 56, "mobileHeight": 60},
    "segment": {"height": 32, "mobileHeight": 48},
    "checkbox": {"size": 16, "mobileSize": 20, "hitArea": 32, "mobileHitArea": 44},
    "table": {"rowHeight": 44, "paddingX": 16, "paddingY": 10}
  },
  "layout": {"sidebar": 248, "inspector": 208, "header": 60, "tabs": 40, "mobileTabs": 48, "toolbar": 48, "statusbar": 28, "mobileNav": 64, "paperWidth": 848, "paperPaddingX": 56, "paperPaddingY": 48, "splitPaperPadding": 32, "mobilePaperPadding": 24, "mobileBreakpoint": 760, "inspectorBreakpoint": 1320},
  "motion": {"feedback": 120, "drawer": 180, "easing": "cubic-bezier(.2, 0, 0, 1)"},
  "themes": {
    "light": {"label": "晴昼", "bg": "#ffffff", "canvas": "#f5f6f8", "sidebar": "#f8f9fb", "source": "#fafbfc", "surface": "#ffffff", "text": "#252b38", "secondary": "#5e6778", "muted": "#626d80", "line": "#e5e8ee", "accent": "#4a5cc5", "accent-ink": "#ffffff", "accent-soft": "#eef1ff", "accent-hover": "#3e50b4", "accent-pressed": "#35469f", "hover": "#eef0f5", "pressed": "#e3e7ef", "code": "#f1f3f7", "disabled-bg": "#eceff4", "disabled-text": "#8d95a4", "success": "#30785d", "danger": "#b33a42", "focus": "#4a5cc5"},
    "warm": {"label": "纸页", "bg": "#fffdf8", "canvas": "#f4f1e9", "sidebar": "#f9f6ef", "source": "#faf7f0", "surface": "#fffdf8", "text": "#39352f", "secondary": "#6c6458", "muted": "#716858", "line": "#e6e0d5", "accent": "#805b36", "accent-ink": "#ffffff", "accent-soft": "#f1e6d6", "accent-hover": "#6e4b29", "accent-pressed": "#5f4023", "hover": "#f0ebe1", "pressed": "#e8dfd0", "code": "#f2ede4", "disabled-bg": "#eeebe5", "disabled-text": "#938a7b", "success": "#427454", "danger": "#ab3b42", "focus": "#805b36"},
    "dark": {"label": "深夜", "bg": "#222735", "canvas": "#191e2a", "sidebar": "#1e2431", "source": "#202634", "surface": "#272f40", "text": "#e8ecf5", "secondary": "#bbc4d5", "muted": "#a1adc3", "line": "#374155", "accent": "#acb9ff", "accent-ink": "#20273d", "accent-soft": "#35415f", "accent-hover": "#c0caff", "accent-pressed": "#95a5ef", "hover": "#303a4d", "pressed": "#39455d", "code": "#2d3649", "disabled-bg": "#30394b", "disabled-text": "#7f8ba3", "success": "#91d5b5", "danger": "#f29a9f", "focus": "#acb9ff"}
  },
  "rules": [
    "只使用 400、500、600 三档字重，不使用 550、650、750 等中间值。",
    "常规界面字号为 12、13px；品牌 20px、弹窗标题 22px；工具符号和手机输入使用 16px。文章正文可调为 14–22px。",
    "按钮、输入框及导航的尺寸由组件 token 决定；手机端可点击目标不小于 44×44px。",
    "同一区域最多突出一个主操作；默认阅读时以编辑文档为主操作。",
    "正文左对齐；默认版心 736px（848px 纸面减去两侧 56px），窄屏单栏。",
    "禁止给单个控件随意增加字号、字重、圆角和间距；确有需要应先调整规范。",
    "普通文本与其实际底色的对比度至少 4.5:1；焦点和选中状态不能仅依靠颜色区别。",
    "所有交互提供默认、悬停、按下、聚焦、禁用状态；加载只用于真实的异步过程。",
    "键盘焦点使用 2px 描边、2px 偏移；减少动画偏好下移除过渡。",
    "跨平台使用系统字体；字形可能因操作系统不同而变化，尺寸、行高和语义层级保持一致。"
  ]
}
