{
  "name": "jianmo",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "tokens": "node scripts/sync-tokens.mjs",
    "test:inprocess": "node --import ./tests/register.mjs --test --test-isolation=none tests/*.test.ts",
    "desktop:setup": "npm install --save-dev @tauri-apps/cli@^2",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-exe.ps1"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "marked": "16.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/turndown": "5.0.6",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "6.4.3"
  }
}
